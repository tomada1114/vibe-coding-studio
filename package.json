    "check:all": "npm run lint --silent && npm run format && npm run type-check && npm run test && npm run validate:indexes",
    "generate:indexes": "tsx scripts/generate-indexes.ts",
    "validate:indexes": "tsx scripts/validate-indexes.ts",
    "optimize:docs-images": "tsx scripts/optimize-docs-images.ts",
    "update:video-indexes": "npm run generate:indexes && npm run validate:indexes"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "@markdoc/markdoc": "^0.5.4",
    "@markdoc/next.js": "^0.5.0",
    "@sindresorhus/slugify": "^3.0.0",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.23.11",
    "geist": "^1.7.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.547.0",
    "next": "15.5.9",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19",
    "react-dom": "^19",
    "react-use-measure": "^2.1.7",
    "simple-functional-loader": "^1.2.1"
  },
  "devDependencies": {
