# Next.js Static Site - Environment Variables

#######
# App #
#######
# Optional: Canonical site URL used in metadata
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

###########
# Discord #
###########
# Optional: Discord Bot Token for fetching server member count
# Create a bot at: https://discord.com/developers/applications
# Required permissions: None (only needs to read server info)
DISCORD_BOT_TOKEN=

# Optional: Discord Guild (Server) ID
# Enable Developer Mode in Discord -> Right-click server -> Copy ID
DISCORD_GUILD_ID=
