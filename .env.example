# Next.js Static Site - Environment Variables

#######
# App #
#######
# Optional: Canonical site URL used in metadata
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

############
# Security #
############
# Optional: Report URI for CSP violations (default: /api/csp-report)
# Example: /api/csp-report
NEXT_PUBLIC_CSP_REPORT_URI=
