{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/install_pkgs.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "tomada-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "tomada1114/tomada-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "tomada-kit@tomada-claude-plugins": true
  }
}
