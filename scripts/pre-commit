#!/usr/bin/env node

/**
 * Git pre-commitフック
 *
 * 動画データまたはUdemy講座データが変更された場合、
 * インデックスを自動的に再生成してステージングエリアに追加します。
 */

const { execSync } = require("child_process")
const fs = require("fs")
const path = require("path")

// ANSI色コード
const COLORS = {
  RESET: "\x1b[0m",
  CYAN: "\x1b[36m",
  GREEN: "\x1b[32m",
  RED: "\x1b[31m",
  YELLOW: "\x1b[33m",
}

function log(message, color = COLORS.RESET) {
  console.log(`${color}${message}${COLORS.RESET}`)
}

function main() {
  try {
    log("🔍 ステージングされたファイルを確認中...", COLORS.CYAN)

    // ステージングエリアのファイルを取得
    const stagedFiles = execSync("git diff --cached --name-only", {
      encoding: "utf-8",
      stdio: ["pipe", "pipe", "pipe"],
    }).trim()

    if (!stagedFiles) {
      log("ℹ️  ステージングされたファイルがありません。", COLORS.YELLOW)
      return
    }

    // インデックス再生成が必要かチェック
    const needsRegeneration =
      stagedFiles.includes("src/data/videos/") ||
      stagedFiles.includes("src/constants/coupon-courses.ts")

    if (!needsRegeneration) {
      log("✅ インデックス再生成は不要です。", COLORS.GREEN)
      return
    }

    log("🔄 動画データまたはUdemy講座データが変更されています。", COLORS.CYAN)
    log("📦 インデックスを再生成中...", COLORS.CYAN)

    // インデックス生成コマンドを実行
    execSync("npm run generate:indexes", {
      stdio: "inherit",
    })

    log("✅ インデックスの再生成が完了しました。", COLORS.GREEN)
    log("📝 インデックスファイルをステージングエリアに追加中...", COLORS.CYAN)

    // 生成されたインデックスファイルをステージングエリアに追加
    const indexesDir = path.join(process.cwd(), "src", "data", "indexes")

    if (fs.existsSync(indexesDir)) {
      execSync("git add src/data/indexes/", {
        stdio: "inherit",
      })
      log(
        "✅ インデックスファイルがステージングエリアに追加されました。",
        COLORS.GREEN
      )
    } else {
      log("⚠️  インデックスディレクトリが見つかりませんでした。", COLORS.YELLOW)
    }

    log("✨ pre-commitフックの処理が完了しました。", COLORS.GREEN)
  } catch (error) {
    log("❌ インデックスの再生成中にエラーが発生しました:", COLORS.RED)
    console.error(error)
    log(
      "💡 ヒント: 以下のコマンドを手動で実行してエラーを確認してください:",
      COLORS.YELLOW
    )
    log("   npm run generate:indexes", COLORS.YELLOW)
    log("", COLORS.RESET)
    log("🚫 コミットを中止します。", COLORS.RED)
    process.exit(1)
  }
}

main()
